# Aufgabe 6 – Referenzlösung: speichere als "Dockerfile" im Projektordner
# Multi-Stage: Stufe 1 baut das Frontend, Stufe 2 ist das schlanke Laufzeit-Image.

# --- Stufe 1: Build ---
FROM node:22-alpine AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
RUN npm run build

# --- Stufe 2: Laufzeit ---
FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production
COPY package*.json ./
RUN npm ci --omit=dev
COPY src ./src
COPY drizzle ./drizzle
COPY data/seed.json ./data/seed.json
COPY --from=build /app/dist/client ./dist/client
EXPOSE 3000
CMD ["npm", "start"]
